# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Kennwort für den Admin-Bereich und das Zurücksetzen der Live-Abstimmung.
# Nur in AI Studio unter Settings → Secrets eintragen, niemals in Dateien.
# Ohne diesen Eintrag bleiben Admin-Bereich und Zurücksetzen gesperrt.
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# POLL_ADMIN_PASSWORD (optional): eigenes Kennwort nur für die Live-Abstimmung.
# Fehlt es, gilt ADMIN_PASSWORD.
POLL_ADMIN_PASSWORD="MY_POLL_ADMIN_PASSWORD"

# GEMINI_MODEL (optional): Gemini-Modell-ID für die KI-Analysen. Kein Geheimnis.
# Standard ist gemini-3.8-flash (laut https://ai.google.dev/models am 26.10.2026 das aktuelle
# stabile Flash-Modell). Nur setzen, wenn Google das Modell abkündigt oder ein anderes gewünscht ist.
# GEMINI_MODEL="gemini-3.8-flash"
