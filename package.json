{
  "name": "baustoffboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node22 --outfile=dist/server.cjs --external:express --external:compression --external:dotenv --external:@google/genai",
    "start": "node server.ts",
    "lint": "tsc --noEmit && eslint .",
    "preview": "vite preview",
    "check:formeln": "node scripts/qa/check-katex.mjs",
    "test": "for f in tests/*.test.ts; do tsx \"$f\" > /dev/null || { echo \"FEHLER in $f\"; tsx \"$f\" | grep FAIL; exit 1; }; echo \"ok  $f\"; done",
    "check:quellen": "node scripts/qa/check-quellen.mjs",
    "check:zahlen": "node scripts/qa/zahlformat-tofixed.mjs --check && node scripts/qa/zahlformat-text.mjs --check && node scripts/qa/zahlformat-jsxtext.mjs --check && node scripts/qa/zahlformat-roh.mjs --check"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-katex": "^3.0.4",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.16.44",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-katex": "^3.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.183.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.0"
  }
}
